APP_NAME="CBT Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Produksi (di balik reverse proxy TLS): aktifkan tiga variabel ini.
# APP_FORCE_HTTPS=true
# SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=*

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbt_laravel
DB_USERNAME=root
DB_PASSWORD=
# DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Produksi: pakai database dan jalankan `php artisan queue:work` (compose menyediakan layanan queue).
# Lokal tanpa worker: sync. Health menandai kombinasi sync di produksi sebagai degraded.
QUEUE_CONNECTION=sync

# Monitor peserta memakai SSE di server produksi. Set false bila hosting
# membatasi koneksi panjang; halaman akan memakai polling biasa.
CBT_SSE_ENABLED=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525

# Produksi: aktifkan SMTP agar notifikasi hasil ujian terkirim ke siswa.
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.sekolah.sch.id
# MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pemantauan: URL health check dan webhook peringatan (Slack/Discord/HTTP).
# HEALTH_URL=https://cbt.sekolah.sch.id/health
# ALERT_WEBHOOK_URL=
# ALERT_THROTTLE_MINUTES=10

BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_AT=01:00
BACKUP_VERIFY_AT=02:00
# MYSQLDUMP_PATH=mysqldump
# Salinan backup kedua (mount jaringan/disk eksternal); kosong = nonaktif.
# BACKUP_OFFSITE_PATH=/mnt/backup-cbt

# Bila diisi, detail /health hanya untuk pemanggil dengan X-Health-Token.
# HEALTH_TOKEN=

VITE_APP_NAME="${APP_NAME}"
